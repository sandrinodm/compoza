{
  "name": "compoza",
  "version": "0.1.0",
  "description": "Builds, ships and runs a Compose stack on a remote Docker host over SSH, with readiness checks and Caddy routing.",
  "homepage": "https://github.com/sandrinodm/compoza#readme",
  "bugs": "https://github.com/sandrinodm/compoza/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sandrinodm/compoza.git"
  },
  "bin": {
    "compoza": "./dist/bin/compoza.mjs"
  },
  "files": [
    "dist",
    "docs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check && jsdoc-lint",
    "deploy": "node bin/compoza.ts",
    "lint:fix": "vp check --fix",
    "lint:jsdoc": "jsdoc-lint",
    "prepare": "vp config",
    "prepack": "vp pack",
    "ready": "pnpm check && vp test",
    "test": "vp test",
    "test:package": "node scripts/package-smoke.mjs"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:",
    "effect": "catalog:",
    "yaml": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "catalog:",
    "jsdoc-lint": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "optionalDependencies": {
    "@1password/sdk": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=26.0.0"
  }
}
